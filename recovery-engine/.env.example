# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Stripe checkout links da LP (`recovery-engine`).
# Use `test` durante validação local e troque para `live` quando publicar.
# O webhook do backend usa `re_plan` no Price/Session para provisionar o tenant.
# VITE_STRIPE_MODE=test
# VITE_STRIPE_TEST_LINK_ESSENTIAL_MONTHLY=https://buy.stripe.com/test_...
# VITE_STRIPE_TEST_LINK_ESSENTIAL_YEARLY=https://buy.stripe.com/test_...
# VITE_STRIPE_TEST_LINK_GROWTH_MONTHLY=https://buy.stripe.com/test_...
# VITE_STRIPE_TEST_LINK_GROWTH_YEARLY=https://buy.stripe.com/test_...
# VITE_STRIPE_LIVE_LINK_ESSENTIAL_MONTHLY=https://buy.stripe.com/...
# VITE_STRIPE_LIVE_LINK_ESSENTIAL_YEARLY=https://buy.stripe.com/...
# VITE_STRIPE_LIVE_LINK_GROWTH_MONTHLY=https://buy.stripe.com/...
# VITE_STRIPE_LIVE_LINK_GROWTH_YEARLY=https://buy.stripe.com/...
#
# CTA de vendas para o plano Scale.
# VITE_SALES_CONTACT_URL=https://wa.me/5511999999999

# Painel RecPay (`apps/web`) — destino do link "Login". Em produção o build usa https://app.recpay.com.br se omitir.
# VITE_DASHBOARD_URL=https://app.recpay.com.br
