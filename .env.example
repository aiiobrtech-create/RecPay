DATABASE_URL=
REDIS_URL=redis://127.0.0.1:6379

# --- Supabase: API valida JWT do painel; front usa as mesmas chaves públicas (VITE_*) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=

# Alinhar os dois quando quiser exigir login (painel + API).
DASHBOARD_AUTH_REQUIRED=true
VITE_DASHBOARD_AUTH_REQUIRED=true

# --- Opcional (defaults no código se omitir) ---
# Marca: APP_ID, APP_DISPLAY_NAME, APP_SLUG — padrões em packages/app-config/src/defaults.ts
# API: API_PORT=3000, API_HOST=0.0.0.0, CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Front: VITE_API_BASE_URL=http://127.0.0.1:3000
# Dev: AUTO_DB_SYNC=0 (sem db:push ao dar npm run dev), DRIZZLE_PUSH_STRICT=0 (drizzle-kit push sem menu)
# Atalho local só em dev: VITE_TENANT_ID=uuid
# Webhook ingress: WEBHOOK_BODY_MAX_BYTES=262144, WEBHOOK_SEED_BASE_URL (scripts seed)
# Admin interno: ADMIN_API_TOKEN
#
# URI do Postgres: se Direct falhar, use pooler Transaction no Supabase ou monte com:
# npm run compose:database-url  (SUPABASE_POOLER_HOST, SUPABASE_DB_USER, SUPABASE_DB_PASSWORD)
#
# Integrações (uma estratégia por plataforma — ver packages/integrations):
# HOTMART_HOTTOK ou HOTMART_WEBHOOK_SECRET
# KIWIFY_WEBHOOK_TOKEN ou KIWIFY_WEBHOOK_SECRET
# HUBLA_WEBHOOK_TOKEN ou HUBLA_WEBHOOK_SECRET
#
# Worker / WhatsApp: RECOVERY_CHANNEL_MODE=simulated|evolution; se evolution: EVOLUTION_API_BASE_URL,
# EVOLUTION_INSTANCE, EVOLUTION_API_KEY, EVOLUTION_SEND_TIMEOUT_MS
# Fallback global anti-spam: RECOVERY_CONTACT_COOLDOWN_MINUTES, RECOVERY_CONTACT_MAX_ATTEMPTS_PER_DAY
# (preferir limites por tenant no dashboard / tabela tenants)
