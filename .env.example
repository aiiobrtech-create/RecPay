DATABASE_URL=
REDIS_URL=redis://127.0.0.1:6379

# --- Supabase: API valida JWT do painel; front usa as mesmas chaves públicas (VITE_*) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=

# Auth seguro por padrão. Só use `false` localmente se quiser forçar o modo legado.
DASHBOARD_AUTH_REQUIRED=true
VITE_DASHBOARD_AUTH_REQUIRED=true

# --- Opcional (defaults no código se omitir) ---
# Marca: APP_ID, APP_DISPLAY_NAME, APP_SLUG — padrões em packages/app-config/src/defaults.ts
# API: API_PORT=3000, API_HOST=0.0.0.0, CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Front: VITE_API_BASE_URL=http://127.0.0.1:3000
# Dev: AUTO_DB_SYNC=0 (sem db:push ao dar npm run dev), DRIZZLE_PUSH_STRICT=0 (drizzle-kit push sem menu)
# Atalho local só em dev: VITE_TENANT_ID=uuid
# Webhook ingress: WEBHOOK_BODY_MAX_BYTES=262144, WEBHOOK_SEED_BASE_URL (scripts seed)
# Provedor generic (query ?provider=generic): em produção exige WEBHOOK_GENERIC_SECRET + header
# x-webhook-generic-secret, ou ALLOW_INSECURE_GENERIC_WEBHOOK=true (só se aceitar o risco).
# Health: HEALTH_READY_TOKEN — em produção, sem isto /health/ready não expõe database/redis/queue.
# Com token: detalhe completo só com Bearer ou X-Health-Token válido. Em dev, sem token, detalhe pode aparecer (debug).
# Proxy: TRUST_PROXY_HOPS=N — número de proxies à frente da API (rate limit por IP usa req.ip).
# Deploy: API_ENV=production — mesmo efeito que NODE_ENV=production para políticas de webhook generic.
# Admin interno: ADMIN_API_TOKEN
#
# Stripe — provisionamento de tenant após compra (webhook `checkout.session.completed` → POST /webhooks/stripe):
# STRIPE_SECRET_KEY=sk_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Opcional — primeiro login / Stripe: FIRST_LOGIN_DEFAULT_BILLING_PLAN, SUPABASE_PASSWORD_RECOVERY_REDIRECT_URL
# Opcional — limites se não vierem na metadata da Session/Price (fallback = tier Essencial: 5000 eventos, 100 recuperações):
# STRIPE_DEFAULT_PLAN_EVENTS_LIMIT=5000
# STRIPE_DEFAULT_PLAN_RECOVERY_LIMIT=100
# No Stripe Price/Session, prefira metadata re_plan=essential|growth|scale — ver docs/PRECIFICACAO.md
#
# URI do Postgres: se Direct falhar, use pooler Transaction no Supabase ou monte com:
# npm run compose:database-url  (SUPABASE_POOLER_HOST, SUPABASE_DB_USER, SUPABASE_DB_PASSWORD)
#
# Integrações (uma estratégia por plataforma — ver packages/integrations):
# HOTMART_HOTTOK ou HOTMART_WEBHOOK_SECRET
# KIWIFY_WEBHOOK_TOKEN ou KIWIFY_WEBHOOK_SECRET
# HUBLA_WEBHOOK_TOKEN ou HUBLA_WEBHOOK_SECRET
#
# Worker / WhatsApp: RECOVERY_CHANNEL_MODE=simulated|evolution; se evolution: EVOLUTION_API_BASE_URL,
# EVOLUTION_INSTANCE, EVOLUTION_API_KEY, EVOLUTION_SEND_TIMEOUT_MS
# Fallback global anti-spam: RECOVERY_CONTACT_COOLDOWN_MINUTES, RECOVERY_CONTACT_MAX_ATTEMPTS_PER_DAY
# (preferir limites por tenant no dashboard / tabela tenants)
